<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="20dp" android:background="#000000" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="CLASS SCHEDULE" android:textColor="#888888" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Widget Setup" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="This first build uses a sample class. We'll connect it to your schedule after the widget is installed." android:textColor="#999999" android:textSize="14sp" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/testButton" android:text="SET SAMPLE CLASS" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Widget data is ready." android:textColor="#AAAAAA" android:textSize="13sp" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>