<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="#000000" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="CLASS SCHEDULE" android:textColor="#888888" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="My Schedule" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/dayMon" android:text="MON" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><Button android:id="@+id/dayTue" android:text="TUE" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><Button android:id="@+id/dayWed" android:text="WED" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><Button android:id="@+id/dayThu" android:text="THU" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><Button android:id="@+id/dayFri" android:text="FRI" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView android:id="@+id/dayTitle" android:text="Monday" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/listContainer" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/addButton" android:text="+ ADD CLASS" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Tap a class to edit or delete it. Changes update the home-screen widget automatically." android:textColor="#777777" android:textSize="12sp" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>