<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="NEXT CLASS" android:textColor="#777777" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/widget_subject" android:text="Mathematics" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" android:maxLines="2" android:layout_marginTop="7dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/widget_time" android:text="7:30 AM – 8:30 AM" android:textColor="#BBBBBB" android:textSize="14sp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/widget_room" android:text="Room 101" android:textColor="#777777" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/widget_teacher" android:text="Teacher Name" android:textColor="#777777" android:textSize="12sp" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>